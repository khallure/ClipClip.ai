{
  "name": "numeral",
  "label": "Numeral",
  "description": "Numbers, years and names go giant behind the speaker, digits rolling into place like an odometer; everything else stays small in front.",
  "engines": ["remotion"],
  "font": {"family": "Montserrat Bold", "file": "Montserrat-Bold.ttf", "weight": 700},
  "case": "upper",
  "size": 2.3,
  "wideScale": 1.5,
  "lineHeight": 1.6,
  "letterSpacing": 0.08,
  "color": "#FFFFFF",
  "shadow": {"x": 0, "y": 0.1, "blur": 0.8, "color": "rgba(0,0,0,0.5)"},
  "emphasis": {"color": {"auto": "accent", "fallback": "#FFE066"}},
  "position": {"y": 68, "marginX": 8, "flex": [52, 84]},
  "page": {"maxWords": 4, "maxCharsPerLine": 24, "maxCharsPerLineWide": 40, "maxLines": 2, "minFrames": 12, "maxFrames": 90, "gapBreakMs": 350},
  "anim": {"type": "numeral", "roll": 22, "spins": 7, "spinStep": 3, "bigOut": 5, "smallIn": 4, "smallRise": 7},
  "behind": {
    "enabled": true,
    "skipFront": true,
    "numbersBehind": true,
    "kinds": ["number", "name"],
    "bigY": 20,
    "bigWidth": 62,
    "bigMaxSize": 20,
    "bandHeight": 0.22,
    "target": 0.22,
    "bigColor": {"auto": "ink", "fallback": "#FFFFFF"},
    "bigFont": {"family": "Anton", "file": "Anton-Regular.ttf", "weight": 400},
    "maxBigWords": 1,
    "maxChars": 8,
    "minHoldMs": 1300,
    "everyMs": 1800,
    "minGapMs": 150,
    "minVisible": 0.45
  },
  "legibility": {"mode": "halo", "max": 1}
}
