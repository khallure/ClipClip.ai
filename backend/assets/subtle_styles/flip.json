{
  "name": "flip",
  "label": "Flip",
  "description": "Every letter flips in like a split-flap tile, turning edge-on and settling upright with a motion-blur trail.",
  "engines": ["remotion"],
  "font": {"family": "Montserrat ExtraBold", "file": "Montserrat-ExtraBold.ttf", "weight": 800},
  "case": "lower",
  "size": 4.4,
  "wideScale": 1.3,
  "lineHeight": 1.25,
  "letterSpacing": 0,
  "color": "#FFFFFF",
  "shadow": {"x": 0, "y": 0.18, "blur": 1.2, "color": "rgba(0,0,0,0.5)"},
  "emphasis": {"color": {"auto": "accent", "fallback": "#FFE066"}},
  "position": {"y": 68, "marginX": 8, "flex": [52, 82]},
  "page": {"maxWords": 4, "maxCharsPerLine": 17, "maxCharsPerLineWide": 32, "maxLines": 2, "minFrames": 14, "maxFrames": 90, "gapBreakMs": 350},
  "anim": {"type": "flip", "letterIn": 9, "stagger": 1.2, "overshoot": 1.15, "trail": 0.1, "shade": "#1A1208", "pageOut": 4},
  "legibility": {"mode": "halo", "max": 1}
}
