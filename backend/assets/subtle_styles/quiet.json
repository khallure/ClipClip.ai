{
  "name": "quiet",
  "label": "Quiet",
  "description": "Lowercase medium sans, each line rises gently into place; no box, a refined soft shadow. The premium brand-film look.",
  "engines": [
    "remotion"
  ],
  "font": {
    "family": "Inter SemiBold",
    "file": "Inter-SemiBold.ttf",
    "weight": 600
  },
  "case": "lower",
  "size": 3.7,
  "wideScale": 1.25,
  "lineHeight": 1.3,
  "letterSpacing": 0.01,
  "color": "#FFFFFF",
  "shadow": {
    "x": 0,
    "y": 0.25,
    "blur": 2.6,
    "color": "rgba(0,0,0,0.78)"
  },
  "position": {
    "y": 74,
    "marginX": 10
  },
  "page": {
    "maxWords": 9,
    "maxCharsPerLine": 30,
    "maxCharsPerLineWide": 52,
    "maxLines": 2,
    "minFrames": 22,
    "maxFrames": 140,
    "gapBreakMs": 500
  },
  "anim": {
    "type": "recipe"
  },
  "recipe": {
    "unit": "line",
    "enter": {
      "kind": "rise",
      "frames": 9,
      "ease": "out-expo",
      "distance": 0.35,
      "stagger": 1
    },
    "exit": {
      "kind": "fade",
      "frames": 6
    },
    "upcoming": {
      "opacity": 1
    },
    "emphasis": {
      "color": "#FFD9A0"
    },
    "align": "center"
  },
  "behind": {
    "enabled": false
  }
}
