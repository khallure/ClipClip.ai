{
  "name": "outline",
  "label": "Outline",
  "description": "A giant hollow word behind the speaker that draws on, then fills with colour as it is spoken; a small bold line in front.",
  "engines": ["remotion"],
  "font": {"family": "Montserrat Bold", "file": "Montserrat-Bold.ttf", "weight": 700},
  "case": "upper",
  "size": 2.3,
  "wideScale": 1.5,
  "lineHeight": 1.6,
  "letterSpacing": 0.08,
  "color": "#FFFFFF",
  "shadow": {"x": 0, "y": 0.1, "blur": 0.8, "color": "rgba(0,0,0,0.5)"},
  "emphasis": {"color": {"auto": "accent", "fallback": "#FFE066"}},
  "position": {"y": 68, "marginX": 8, "flex": [52, 84]},
  "page": {"maxWords": 4, "maxCharsPerLine": 24, "maxCharsPerLineWide": 40, "maxLines": 2, "minFrames": 12, "maxFrames": 90, "gapBreakMs": 350},
  "anim": {"type": "outline", "lead": 14, "wipe": 8, "fillDelay": 1, "fillIn": 14, "stroke": 0.022, "strokeColor": "#FFFFFF", "bigOut": 5, "smallIn": 4, "smallRise": 7},
  "behind": {
    "enabled": true,
    "skipFront": true,
    "bigY": 20,
    "bigWidth": 88,
    "bigMaxSize": 30,
    "bandHeight": 0.2,
    "target": 0.22,
    "bigOpacity": 1,
    "bigColor": "#FFFFFF",
    "bigFont": {"family": "Anton", "file": "Anton-Regular.ttf", "weight": 400},
    "maxBigWords": 1,
    "maxChars": 11,
    "minHoldMs": 1000,
    "everyMs": 1800,
    "minGapMs": 150,
    "minVisible": 0.45
  },
  "legibility": {"mode": "halo", "max": 1}
}
