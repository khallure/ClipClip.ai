{
  "name": "impact",
  "label": "Impact",
  "description": "Heavy round caps; every letter bounces in along an arc with overshoot and a little tilt, on a hard offset shadow.",
  "engines": [
    "remotion"
  ],
  "font": {
    "family": "Poppins Black",
    "file": "Poppins-Black.ttf",
    "weight": 900
  },
  "case": "upper",
  "size": 6.4,
  "wideScale": 1.1,
  "lineHeight": 1.12,
  "letterSpacing": -0.02,
  "color": "#FFFFFF",
  "activeColor": "#FEFA1D",
  "shadow": null,
  "position": {
    "y": 70,
    "marginX": 8
  },
  "page": {
    "maxWords": 5,
    "maxCharsPerLine": 12,
    "maxCharsPerLineWide": 22,
    "maxLines": 2,
    "minFrames": 14,
    "maxFrames": 80,
    "gapBreakMs": 300
  },
  "anim": {
    "type": "impact",
    "letterIn": 5,
    "stagger": 1,
    "scaleFrom": 0.4,
    "rotate": -10,
    "rise": 46,
    "arc": 14,
    "drift": 10,
    "stroke": 6,
    "strokeColor": "#000000",
    "shadowY": 4.5,
    "shadowColor": "#000000"
  },
  "behind": {
    "enabled": false
  },
  "legibility": {
    "mode": "halo",
    "max": 0.6
  }
}
