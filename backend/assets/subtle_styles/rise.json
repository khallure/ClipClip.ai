{
  "name": "rise",
  "label": "Rise",
  "description": "The giant word climbs out from behind the speaker's shoulders letter by letter, and sinks back when the word is done.",
  "engines": ["remotion"],
  "font": {"family": "Montserrat Bold", "file": "Montserrat-Bold.ttf", "weight": 700},
  "case": "lower",
  "size": 2.5,
  "wideScale": 1.5,
  "lineHeight": 1.5,
  "letterSpacing": 0,
  "color": "#FFFFFF",
  "shadow": {"x": 0, "y": 0.12, "blur": 0.9, "color": "rgba(0,0,0,0.5)"},
  "emphasis": {"color": {"auto": "accent", "fallback": "#FFE066"}},
  "position": {"y": 68, "marginX": 8, "flex": [52, 84]},
  "page": {"maxWords": 4, "maxCharsPerLine": 24, "maxCharsPerLineWide": 40, "maxLines": 2, "minFrames": 12, "maxFrames": 90, "gapBreakMs": 350},
  "anim": {"type": "rise", "rise": 12, "sink": 8, "stagger": 1.3, "overshoot": 1.0, "tracking": 0.01, "tuck": 0.05, "smallIn": 4, "smallRise": 7},
  "behind": {
    "enabled": true,
    "skipFront": true,
    "bigY": 24,
    "bigWidth": 90,
    "bigMaxSize": 26,
    "bandHeight": 0.2,
    "target": 0.3,
    "bigColor": {"auto": "ink", "fallback": "#FFFFFF"},
    "bigFont": {"family": "Anton", "file": "Anton-Regular.ttf", "weight": 400},
    "maxBigWords": 1,
    "maxChars": 11,
    "minHoldMs": 1000,
    "everyMs": 1800,
    "minGapMs": 150,
    "minVisible": 0.45
  },
  "legibility": {"mode": "halo", "max": 1}
}
