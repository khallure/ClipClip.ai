{
  "name": "magazine",
  "label": "Magazine",
  "description": "A tight justified block like an ad super: keywords in big serif italic, glue words in small grotesk capitals, every line the same width.",
  "engines": ["remotion"],
  "font": {"family": "Montserrat Bold", "file": "Montserrat-Bold.ttf", "weight": 700},
  "case": "sentence",
  "size": 4.6,
  "wideScale": 1.3,
  "lineHeight": 1.1,
  "letterSpacing": 0,
  "color": "#FFFFFF",
  "shadow": {"x": 0, "y": 0.12, "blur": 1.1, "color": "rgba(0,0,0,0.5)"},
  "emphasis": {"color": {"auto": "accent", "fallback": "#FFE9A8"}},
  "position": {"y": 66, "marginX": 8, "flex": [50, 80]},
  "page": {"maxWords": 6, "maxCharsPerLine": 18, "maxCharsPerLineWide": 34, "maxLines": 3, "minFrames": 16, "maxFrames": 100, "gapBreakMs": 400},
  "anim": {
    "type": "magazine",
    "serifFont": {"family": "Instrument Serif Italic", "file": "InstrumentSerif-Italic.ttf", "weight": 400},
    "serifScale": 1.35, "keyScale": 1.75, "glueScale": 0.5, "blockWidth": 78, "wordGap": 0.8,
    "minStretch": 0.7, "maxStretch": 1.45, "lineGap": 0.011, "wordIn": 4, "rise": 10, "pageOut": 4,
    "glueOpacity": 0.92
  },
  "legibility": {"mode": "halo", "max": 1}
}
