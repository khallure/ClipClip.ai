{
  "name": "glide",
  "label": "Glide",
  "description": "Key words in a large calligraphic script, the small words in bold white sans, on one baseline.",
  "engines": [
    "remotion"
  ],
  "font": {
    "family": "Inter Bold",
    "file": "Inter-Bold.ttf",
    "weight": 700
  },
  "emphasisFont": {
    "family": "Pinyon Script",
    "file": "PinyonScript-Regular.ttf",
    "weight": 400
  },
  "case": "sentence",
  "size": 3.9,
  "wideScale": 1.3,
  "lineHeight": 1.2,
  "letterSpacing": 0,
  "color": "#FFFFFF",
  "activeColor": {
    "auto": "accent",
    "fallback": "#F5F258"
  },
  "shadow": {
    "x": 0,
    "y": 0.22,
    "blur": 0.5,
    "color": "rgba(0,0,0,0.5)"
  },
  "emphasis": {
    "numberFont": {
      "family": "Playfair Display Medium Italic",
      "file": "PlayfairDisplay-MediumItalic.ttf",
      "weight": 500
    },
    "numberScale": 1.7
  },
  "position": {
    "y": 52,
    "marginX": 6
  },
  "page": {
    "maxWords": 5,
    "maxCharsPerLine": 24,
    "maxCharsPerLineWide": 40,
    "maxLines": 1,
    "minFrames": 14,
    "maxFrames": 75,
    "gapBreakMs": 350
  },
  "anim": {
    "type": "glide",
    "scriptScale": 3.1,
    "scriptFrom": 0.1,
    "scriptIn": 5,
    "wordIn": 2,
    "pageOut": 2,
    "glowBlur": 5,
    "scriptBold": 0.9
  },
  "behind": {
    "enabled": false
  },
  "legibility": {
    "mode": "halo",
    "max": 1
  }
}
