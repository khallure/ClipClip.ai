{
  "name": "cover",
  "label": "Cover",
  "description": "One huge serif italic word behind the speaker's head, like a magazine masthead; the rest of the line small and tracked in front.",
  "engines": ["remotion"],
  "font": {"family": "Inter Medium", "file": "Inter-Medium.ttf", "weight": 500},
  "case": "upper",
  "size": 2.1,
  "wideScale": 1.5,
  "lineHeight": 1.7,
  "letterSpacing": 0.16,
  "color": "#F6F1E7",
  "shadow": {"x": 0, "y": 0.1, "blur": 0.7, "color": "rgba(0,0,0,0.45)"},
  "emphasis": {"color": "#FFFFFF", "font": {"family": "Instrument Serif Italic", "file": "InstrumentSerif-Italic.ttf", "weight": 400}, "scale": 1.7},
  "position": {"y": 66, "marginX": 8, "flex": [52, 84]},
  "page": {"maxWords": 4, "maxCharsPerLine": 22, "maxCharsPerLineWide": 40, "maxLines": 2, "minFrames": 12, "maxFrames": 90, "gapBreakMs": 350},
  "anim": {"type": "cover", "bigIn": 10, "bigOut": 5, "bigScale": 0.06, "bigBlur": 14, "bigTracking": -0.01, "smallIn": 5, "smallRise": 8},
  "behind": {
    "enabled": true,
    "skipFront": true,
    "bigY": 20,
    "bigWidth": 88,
    "bigMaxSize": 26,
    "bandHeight": 0.2,
    "target": 0.2,
    "bigOpacity": 1,
    "bigColor": "#F6F1E7",
    "bigFont": {"family": "Instrument Serif Italic", "file": "InstrumentSerif-Italic.ttf", "weight": 400},
    "maxBigWords": 1,
    "maxChars": 12,
    "minHoldMs": 1000,
    "everyMs": 1800,
    "minGapMs": 150,
    "minVisible": 0.4
  },
  "legibility": {"mode": "halo", "max": 1}
}
