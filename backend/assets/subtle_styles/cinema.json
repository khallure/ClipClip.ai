{
  "name": "cinema",
  "label": "Cinema",
  "description": "Tiny, wide-tracked serif capitals low in the frame that fade in and out slowly, like the subtitles of an arthouse trailer.",
  "engines": ["remotion"],
  "font": {"family": "Libre Baskerville", "file": "LibreBaskerville-wght.ttf", "weight": 500},
  "case": "upper",
  "size": 1.9,
  "wideScale": 1.3,
  "lineHeight": 2.1,
  "letterSpacing": 0.36,
  "color": "#EFE9DD",
  "shadow": {"x": 0, "y": 0.1, "blur": 1.2, "color": "rgba(0,0,0,0.7)"},
  "position": {"y": 82, "marginX": 9, "flex": [66, 88]},
  "page": {"maxWords": 6, "maxCharsPerLine": 26, "maxCharsPerLineWide": 46, "maxLines": 2, "minFrames": 24, "maxFrames": 150, "gapBreakMs": 500},
  "anim": {"type": "recipe"},
  "recipe": {
    "unit": "page",
    "enter": {"kind": "blur-in", "frames": 16, "ease": "out-cubic", "distance": 0.5},
    "exit": {"kind": "blur-out", "frames": 12},
    "upcoming": {"opacity": 0},
    "emphasis": {"color": "#FFFFFF"}
  },
  "legibility": {"mode": "halo", "max": 1}
}
