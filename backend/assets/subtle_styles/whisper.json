{
  "name": "whisper",
  "label": "Whisper",
  "description": "Lowercase warm-yellow text; each word is revealed by a soft left-to-right wipe and the page dissolves with a blur.",
  "engines": [
    "remotion"
  ],
  "font": {
    "family": "Inter SemiBold",
    "file": "Inter-SemiBold.ttf",
    "weight": 600
  },
  "case": "lower",
  "size": 5.0,
  "wideScale": 1.3,
  "lineHeight": 1.2,
  "letterSpacing": -0.01,
  "color": "#F0D530",
  "shadow": {
    "x": 0,
    "y": 0.12,
    "blur": 0.7,
    "color": "rgba(0,0,0,0.55)"
  },
  "emphasis": {
    "color": "#FFFFFF",
    "font": {
      "family": "Inter Bold",
      "file": "Inter-Bold.ttf",
      "weight": 700
    }
  },
  "position": {
    "y": 68,
    "marginX": 7
  },
  "page": {
    "maxWords": 4,
    "maxCharsPerLine": 22,
    "maxCharsPerLineWide": 36,
    "maxLines": 1,
    "minFrames": 14,
    "maxFrames": 90,
    "gapBreakMs": 350
  },
  "anim": {
    "type": "whisper",
    "wipe": 9,
    "feather": 0.35,
    "wordBlur": 3,
    "pageOut": 5,
    "pageBlur": 7
  },
  "behind": {
    "enabled": false
  },
  "legibility": {
    "mode": "halo",
    "max": 0.85
  }
}
