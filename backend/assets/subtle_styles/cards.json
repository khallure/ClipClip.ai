{
  "name": "cards",
  "label": "Cards",
  "description": "White serif on a dark rounded card; the phrase appears at once, key words in red. The essay and serif-card look.",
  "engines": [
    "remotion"
  ],
  "font": {
    "family": "Instrument Serif Regular",
    "file": "InstrumentSerif-Regular.ttf",
    "weight": 400
  },
  "case": "sentence",
  "size": 5.0,
  "wideScale": 1.25,
  "lineHeight": 1.12,
  "letterSpacing": 0,
  "color": "#FFFFFF",
  "shadow": null,
  "backdropBlur": 14,
  "position": {
    "y": 71,
    "marginX": 9
  },
  "page": {
    "maxWords": 9,
    "maxCharsPerLine": 26,
    "maxCharsPerLineWide": 44,
    "maxLines": 2,
    "minFrames": 22,
    "maxFrames": 130,
    "gapBreakMs": 450
  },
  "anim": {
    "type": "recipe"
  },
  "recipe": {
    "unit": "page",
    "enter": {
      "kind": "fade",
      "frames": 5,
      "ease": "out-cubic"
    },
    "exit": {
      "kind": "fade",
      "frames": 4
    },
    "upcoming": {
      "opacity": 1
    },
    "plate": {
      "kind": "page",
      "color": "rgba(14,12,12,0.66)",
      "radius": 0.5,
      "padX": 0.65,
      "padY": 0.28,
      "backdropBlur": 14
    },
    "emphasis": {
      "color": "#FF5A4F",
      "font": {
        "family": "Instrument Serif Italic",
        "file": "InstrumentSerif-Italic.ttf",
        "weight": 400
      }
    },
    "align": "center"
  },
  "behind": {
    "enabled": false
  }
}
