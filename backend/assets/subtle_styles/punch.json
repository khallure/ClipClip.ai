{
  "name": "punch",
  "label": "Punch",
  "description": "Heavy upper-case sans that pops in word by word with overshoot; the spoken word swells and turns lime, thick black outline. The short-form creator look.",
  "engines": [
    "remotion"
  ],
  "font": {
    "family": "Montserrat Black",
    "file": "Montserrat-Black.ttf",
    "weight": 900
  },
  "case": "upper",
  "size": 5.4,
  "wideScale": 1.15,
  "lineHeight": 1.1,
  "letterSpacing": -0.005,
  "color": "#FFFFFF",
  "shadow": {
    "x": 0,
    "y": 0.45,
    "blur": 0.5,
    "color": "rgba(0,0,0,0.5)"
  },
  "position": {
    "y": 62,
    "marginX": 8
  },
  "page": {
    "maxWords": 4,
    "maxCharsPerLine": 14,
    "maxCharsPerLineWide": 30,
    "maxLines": 2,
    "minFrames": 12,
    "maxFrames": 80,
    "gapBreakMs": 350
  },
  "anim": {
    "type": "recipe"
  },
  "recipe": {
    "unit": "word",
    "enter": {
      "kind": "pop",
      "frames": 6,
      "ease": "out-back",
      "overshoot": 1.14
    },
    "exit": {
      "kind": "cut",
      "frames": 2
    },
    "upcoming": {
      "opacity": 0
    },
    "active": {
      "color": "#C8FF2E",
      "scale": 1.08
    },
    "spoken": {
      "color": null
    },
    "stroke": {
      "width": 0.07,
      "color": "#000000"
    },
    "emphasis": {
      "color": "#C8FF2E",
      "scale": 1.0
    },
    "align": "center"
  },
  "behind": {
    "enabled": false
  }
}
