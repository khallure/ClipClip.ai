{
  "name": "singalong",
  "label": "Singalong",
  "description": "A block of up to four lyric lines; the sung part of each line fills with a soft colour, letter by letter, as it is sung. Variant lit: no fill, words light up over the picture.",
  "group": "music",
  "engines": [
    "remotion"
  ],
  "font": {
    "family": "Inter SemiBold",
    "file": "Inter-SemiBold.ttf",
    "weight": 600
  },
  "case": "sentence",
  "size": 5.6,
  "wideScale": 1.35,
  "lineHeight": 1.6,
  "letterSpacing": 0,
  "color": "#F4F1EA",
  "activeColor": "#B49BFF",
  "shadow": null,
  "emphasis": {
    "color": "#FFD98A",
    "scale": 1.06
  },
  "position": {
    "y": 45,
    "marginX": 8
  },
  "page": {
    "unit": "line",
    "linesPerPage": 4,
    "maxWords": 6,
    "maxCharsPerLine": 18,
    "maxCharsPerLineWide": 44,
    "maxLines": 4,
    "snap": "bar",
    "hold": true,
    "minFrames": 20,
    "maxFrames": 400,
    "gapBreakMs": 1500,
    "blockGapMs": 2500
