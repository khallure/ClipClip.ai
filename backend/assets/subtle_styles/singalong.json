      "lineHeight": 1.3,
      "color": "#FFFFFF",
      "shadow": {
        "x": 0,
        "y": 0.12,
        "blur": 0.7,
        "color": "rgba(0,0,0,0.5)"
      },
      "emphasis": {
        "color": "#FFFFFF",
        "scale": 1.08
      },
      "position": {
        "y": 72,
        "marginX": 8
      },
      "page": {
        "linesPerPage": 2,
        "maxCharsPerLine": 16,
        "maxLines": 2,
