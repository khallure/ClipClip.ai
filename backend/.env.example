# Copy this file to backend/.env. Never put API keys in frontend settings.
# Leave empty to use the clearly labelled local heuristic analysis.
AI_PROVIDER=auto
# Gemini Free Tier is limited by the account/project quota. No paid fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Automatic transcription is optional; see scripts/setup.ps1 -WithWhisper.
# The first use downloads a model. CPU is the portable Windows default.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional isolated Active Speaker models: scripts/Setup-ActiveSpeaker.ps1.
# auto prefers the verified NVIDIA runtime; cpu forces .venv-asd.
ASD_DEVICE=auto

# Optional absolute paths. Leave empty to detect binaries on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Storage is local. Relative DATA_DIR is resolved by the backend.
# DATA_DIR=data
MAX_UPLOAD_MB=8192
STORAGE_LIMIT_GB=30
# Reject files beyond this duration; sources over two hours are permitted.
MAX_DURATION_HOURS=12

# Optional YouTube source retrieval. Dependency: setup.ps1 -WithIngestion (Python 3.11+).
# Enable for accessible sources whose access and use are permitted.
# This feature switch does not grant permission or bypass source restrictions.
# Legacy YOUTUBE_APPROVAL_REFERENCE / YOUTUBE_APPROVED_VIDEO_IDS are ignored.
YOUTUBE_INGEST_ENABLED=false
YOUTUBE_SOURCE_MAX_HEIGHT=2160
YOUTUBE_INGEST_TIMEOUT_SEC=1800
YOUTUBE_CACHE_RETENTION_DAYS=7
# Optional Node.js path for yt-dlp's local EJS runtime; launchers detect Node.
NODE_PATH=
